{
  "name": "switchyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Subscription-aware economic model router for coding agents",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "bench": "tsx eval/benchmark.ts",
    "bench:live": "tsx scripts/bench-live.ts",
    "catalog": "tsx scripts/catalog.ts",
    "typecheck": "tsc --noEmit",
    "eval:classifier": "tsx scripts/classifier-eval.ts",
    "outcomes": "tsx scripts/outcomes.ts",
    "build": "for p in packages/core packages/catalog packages/provider-openrouter packages/adapter-pi; do tsc -p $p/tsconfig.build.json; done"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "pi-package",
    "model-router",
    "llm",
    "codex",
    "openrouter"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
