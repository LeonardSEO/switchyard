{
  "name": "switchyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Subscription-aware model router for coding agents: routes every turn to the cheapest capable model across OpenRouter and your Codex plan",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "bench": "tsx eval/benchmark.ts",
    "bench:live": "tsx scripts/bench-live.ts",
    "catalog": "tsx scripts/catalog.ts",
    "typecheck": "tsc --noEmit",
    "eval:classifier": "tsx scripts/classifier-eval.ts",
    "outcomes": "tsx scripts/outcomes.ts",
    "build": "for p in core catalog provider-openrouter adapter-pi gateway opencode; do tsc -p packages/$p/tsconfig.build.json || exit 1; done"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "model-router",
    "llm-router",
    "ai-router",
    "model-routing",
    "llm",
    "ai",
    "coding-agent",
    "ai-coding",
    "openrouter",
    "codex",
    "chatgpt-subscription",
    "cost-optimization",
    "cost-aware",
    "token-cost",
    "llm-gateway",
    "openai-compatible",
    "pi-package",
    "opencode",
    "developer-tools",
    "typescript"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
