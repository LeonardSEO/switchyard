{
  "version": "0.3.3",
  "license": "Apache-2.0",
  "type": "module",
  "author": "LeonardSEO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonardSEO/switchyard.git"
  },
  "homepage": "https://github.com/LeonardSEO/switchyard#readme",
  "bugs": {
    "url": "https://github.com/LeonardSEO/switchyard/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "name": "@vepando/switchyard",
  "description": "Subscription-aware model routing for Pi, OpenCode and every OpenAI-compatible coding agent",
  "main": "./dist/opencode.js",
  "exports": {
    ".": {
      "default": "./dist/opencode.js"
    },
    "./pi": {
      "types": "./dist/index.d.ts",
      "default": "./dist/pi.js"
    },
    "./opencode": {
      "default": "./dist/opencode.js"
    },
    "./gateway": {
      "default": "./dist/gateway.js"
    },
    "./extension": {
      "default": "./extensions/switchyard.js"
    }
  },
  "bin": {
    "switchyard-gateway": "./bin/switchyard-gateway.js"
  },
  "files": [
    "dist",
    "extensions",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "omp",
    "oh-my-pi",
    "model-router",
    "llm-router",
    "ai-router",
    "model-routing",
    "llm",
    "ai",
    "coding-agent",
    "ai-coding",
    "openrouter",
    "codex",
    "cost-optimization",
    "cost-aware",
    "developer-tools"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "omp": {
    "extensions": [
      "./extensions"
    ]
  }
}
