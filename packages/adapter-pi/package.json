{
  "version": "0.1.2",
  "license": "Apache-2.0",
  "type": "module",
  "author": "LeonardSEO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonardSEO/switchyard.git"
  },
  "homepage": "https://github.com/LeonardSEO/switchyard#readme",
  "bugs": {
    "url": "https://github.com/LeonardSEO/switchyard/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "name": "@vepando/switchyard",
  "description": "Route every Pi turn to the right model, including the subscription you already pay for",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extension": {
      "default": "./extensions/switchyard.js"
    }
  },
  "files": [
    "dist",
    "src",
    "extensions",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "model-router",
    "llm",
    "codex",
    "openrouter"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "dependencies": {
    "@vepando/switchyard-catalog": "^0.1.0",
    "@vepando/switchyard-core": "^0.1.0"
  }
}
